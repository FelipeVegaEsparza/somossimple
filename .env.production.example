# Variables para el despliegue en producción (Dokploy).
# Cópialas en el panel de Dokploy (Environment) o en el .env del proyecto Compose.
# Genera APP_KEY con: php artisan key:generate --show

APP_NAME=SomosSimple
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.cl

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Santiago

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Base de datos: por defecto usa el servicio "mysql" del propio compose.
# No definas DB_HOST con el hostname de un MySQL externo si usas el incluido.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=simpledb
DB_USERNAME=simple
DB_PASSWORD=simple_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@somossimple.cl"
MAIL_FROM_NAME="SomosSimple"

# Integraciones opcionales: déjalas en false hasta tener credenciales reales.
LOYALTY_APPLE_WALLET_ENABLED=false
LOYALTY_GOOGLE_WALLET_ENABLED=false

TICKETERA_PAYMENT_PROVIDER=manual
TICKETERA_WEBPAY_ENABLED=false
TICKETERA_MERCADOPAGO_ENABLED=false
TICKETERA_FLOW_ENABLED=false
TICKETERA_APPLE_WALLET_ENABLED=false
TICKETERA_GOOGLE_WALLET_ENABLED=false
